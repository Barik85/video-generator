# Needed only for real presets. "mock" and "mock-native" run offline.

# or-* presets (OpenRouter: Claude, ElevenLabs TTS/Scribe, Seedream, Seedance/Veo/Kling) — one key for everything
OPENROUTER_API_KEY=

# seedance-fast / seedance-2.5 presets (direct)
ANTHROPIC_API_KEY=      # script + shot plan (Claude, structured output)
FAL_KEY=                # video (Seedance), keyframes (Seedream), TTS (ElevenLabs v3), ASR (ElevenLabs Scribe) via fal.ai

# Optional
# REEL_LLM_MODEL=claude-opus-5-5
# REEL_VOICE_FEMALE=Sarah
# REEL_VOICE_MALE=George
# REEL_MAX_WER=0          # verbatim tolerance; 0 = every word must match
# REEL_VIDEO_TAKES=3      # native-audio presets: paid takes per shot before keeping the closest one
# REEL_MOCK_FAIL=video:1  # mock preset: inject N transient failures per provider kind

# Runner (see README "Runners"): local (default) or temporal
# REEL_RUNNER=temporal
# TEMPORAL_ADDRESS=localhost:7233   # unset: --runner temporal starts a dev server + worker in-process
# TEMPORAL_NAMESPACE=default
# REEL_MOCK_VIDEO_MS=15000           # mock presets: make each clip take this long (to demo killing a worker)
